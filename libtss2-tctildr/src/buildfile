intf_libs = # Interface dependencies.
impl_libs = # Implementation dependencies.

import intf_libs += libtss2-headers%lib{tss2-headers}

# tctildr-nodl.c (used instead of tctildr-dl.c on Windows, which has no
# dlopen()) unconditionally requires the Windows TBS TCTI at build time.
#
if ($c.target.class == 'windows')
  import impl_libs += libtss2-tcti-tbs%lib{tss2-tcti-tbs}

# Public headers.
#
pub = [dir_path] ../include/tss2/

include $pub

pub_hdrs = $($pub/ pub_hdrs)

lib{tss2-tctildr}: libul{tss2-tctildr}: $pub/{$pub_hdrs}

# Private headers and sources as well as dependencies.
#
# tctildr-dl.c dynamically loads TCTI modules with dlopen(), which Windows
# does not provide. tctildr-nodl.c is upstream's alternative for Windows: a
# static table of known TCTIs (see the libtss2-tcti-tbs import above).
#
libul{tss2-tctildr}: {h c}{** -tss2-tcti/tctildr-dl -tss2-tcti/tctildr-nodl} $impl_libs $intf_libs
libul{tss2-tctildr}: tss2-tcti/{h c}{tctildr-dl}:   include = ($c.target.class != 'windows')
libul{tss2-tctildr}: tss2-tcti/{h c}{tctildr-nodl}: include = ($c.target.class == 'windows')

libs{tss2-tctildr}: def{tss2-tctildr}: include = ($c.target.system == 'win32-msvc')
def{tss2-tctildr}: libul{tss2-tctildr}

# Build options.
#
# The sources include the public headers with unqualified names, so the
# tss2/ directory is also on the private header search path.
#
out_pfx_inc = [dir_path] $out_root/include/
src_pfx_inc = [dir_path] $src_root/include/
out_pfx_unq = [dir_path] $out_root/include/tss2/
src_pfx_unq = [dir_path] $src_root/include/tss2/
out_pfx_src = [dir_path] $out_root/src/
src_pfx_src = [dir_path] $src_root/src/

c.poptions =+ "-I$out_pfx_src" "-I$src_pfx_src" \
              "-I$out_pfx_inc" "-I$src_pfx_inc" \
              "-I$out_pfx_unq" "-I$src_pfx_unq"

# Matches upstream's own default (autotools --enable-log-file): lets
# TSS2_LOGFILE redirect log output to a file at runtime. Does not
# enable logging itself (see log.c's LOGDEFAULT, warning level).
#
c.poptions += -DLOG_FILE_ENABLED

# The TCTI modules are loaded with dlopen().
#
if ($c.target.class == 'linux')
  c.libs += -ldl

# The upstream logging macros are invoked without variadic arguments, which
# Clang only diagnoses in pedantic mode.
#
if ($c.id.type == 'clang')
  c.coptions += -Wno-variadic-macro-arguments-omitted \
                -Wno-unknown-warning-option

# dlsym()'s pointer cast triggers -Wpedantic on GCC and Clang, neither of
# which has a dedicated flag for it. GNU-style compilers only.
#
if ($c.class == 'gcc')
  tss2-tcti/obj{tctildr-dl}: c.coptions += -Wno-pedantic

# The Microsoft UCRT (targeted by both MSVC and Clang in MSVC mode) has no
# POSIX strtok_r(); its strtok_s() is a drop-in replacement (identical
# signature and semantics). MinGW's own CRT already provides strtok_r().
#
if ($c.target.system == 'win32-msvc')
  util/obj{key-value-parse}: c.poptions += -Dstrtok_r=strtok_s

# tctildr.c uses a bare __attribute__((weak)). MSVC doesn't understand it
# at all, and Clang, which does, encodes it as a COFF weak-external alias
# whose mangled name bin.def's auto-generated .def then rejects as an
# invalid export symbol ('.weak.Tss2_Tcti_Info.default.tcti_from_init').
# Force-include a small local shim that neutralizes it on both, without
# touching upstream source (dropping "weak" changes nothing here: nothing
# else defines these symbols for it to yield to).
#
if ($c.target.system == 'win32-msvc')
{
  if ($c.id.type == 'msvc')
    tss2-tcti/obj{tctildr}: c.coptions += "/FI$src_base/msvc-attribute.h"
  else
    tss2-tcti/obj{tctildr}: c.coptions += -include "$src_base/msvc-attribute.h"
}

if ($c.target.system == 'mingw32')
  c.loptions += -Wl,--export-all-symbols

# tctildr.c calls strndup(), which some mingw-w64 toolchain builds don't
# declare even under _GNU_SOURCE (confirmed: defining _GNU_SOURCE alone
# was not sufficient on a real CI mingw_w64 bot, even though it is on the
# local MSYS2 UCRT64 toolchain, so this varies by mingw-w64 build, not by
# feature-test macro). MSVC and Clang in MSVC mode are unaffected:
# tctildr.c already provides its own strndup() fallback for _MSC_VER.
# Force-include a portable fallback the same way as msvc-attribute.h
# above, without touching upstream source.
#
if ($c.target.system == 'mingw32')
  tss2-tcti/obj{tctildr}: c.coptions += -include "$src_base/mingw-strndup.h"

# Export options.
#
# The public headers include each other with unqualified names, so consumers
# also need the tss2/ directory on their header search path.
#
lib{tss2-tctildr}:
{
  c.export.poptions = "-I$out_pfx_inc" "-I$src_pfx_inc" \
                      "-I$out_pfx_unq" "-I$src_pfx_unq"
  c.export.libs = $intf_libs
}

lib{tss2-tctildr}: c.pkgconfig.include = include/ include/tss2/

# Only export the public API from the shared library on ELF targets.
#
lib{tss2-tctildr}: file{tss2-tctildr.map}: include = adhoc

if ($c.target.class == 'linux' || $c.target.class == 'bsd')
  libs{tss2-tctildr}: c.loptions += "-Wl,--version-script=$src_base/tss2-tctildr.map"

# For pre-releases use the complete version to make sure they cannot
# be used in place of another pre-release or the final version. See
# the version module for details on the version.* variable values.
#
# A final release uses the same shared library names as upstream (libtool
# version-info 0:0:0): libtss2-tctildr.so.0.0.0 with SONAME libtss2-tctildr.so.0 on
# Linux, libtss2-tctildr.so.0 on BSD, and libtss2-tctildr.0.dylib on macOS. linux@
# needs MAJOR.MINOR[.EXTRA], macos@ and bsd@ are not implemented, so the
# BSD name is set through the extension.
#
if $version.pre_release
  lib{tss2-tctildr}: bin.lib.version = "-$version.project_id"
elif ($c.target.class == 'macos')
  lib{tss2-tctildr}: bin.lib.version = ".0"
elif ($c.target.class == 'bsd')
  libs{tss2-tctildr}: extension = "so.0"
else
  lib{tss2-tctildr}: bin.lib.version = "-0" linux@"0.0.0"

# Don't install private headers.
#
h{*}: install = false
