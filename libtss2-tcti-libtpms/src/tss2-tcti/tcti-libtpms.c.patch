 #if defined(__FreeBSD__)
 #define mremap(a, b, c, d) ((void *)(-1))
+#elif defined(__APPLE__)
+#define mremap(a, b, c, d) ((void *)(-1))
+#define posix_fallocate(fd, offset, len) (ENOSYS)
+#elif defined(_WIN32)
+#define posix_fallocate(fd, offset, len) (ENOSYS)
+#define open  _open
+#define close _close
+#define lseek _lseek
+/* truncate() itself is declared in compat/unistd.h (only ever reached for
+ * a state file path, which is rejected before this can run, see the conf
+ * handling in Tss2_Tcti_Libtpms_Init() below). */
+
+/* No mmap()/munmap()/mremap() on Windows at all. The only mapping this file
+ * ever creates here is the anonymous (no state file) case, so back it with
+ * plain heap memory instead of porting the state-file persistence to
+ * CreateFileMapping()/MapViewOfFile(). mmap() zero-fills anonymous memory,
+ * which calloc() matches; growing via mremap() preserves existing content
+ * and zero-fills the new tail, which realloc() plus a manual memset() of
+ * the tail matches.
+ */
+#define MAP_FAILED     NULL
+#define PROT_READ      0
+#define PROT_WRITE     0
+#define MAP_PRIVATE    0
+#define MAP_SHARED     0
+#define MAP_ANONYMOUS  0
+#define MREMAP_MAYMOVE 0
+
+static __inline void *
+tcti_libtpms_win_mmap_anon(size_t len) {
+    return calloc(1, len);
+}
+
+static __inline void *
+tcti_libtpms_win_mremap_anon(void *addr, size_t old_len, size_t new_len) {
+    void *p = realloc(addr, new_len);
+    if (p != NULL && new_len > old_len) {
+        memset((unsigned char *)p + old_len, 0, new_len - old_len);
+    }
+    return p;
+}
+
+#define mmap(addr, len, prot, flags, fd, off) tcti_libtpms_win_mmap_anon(len)
+#define mremap(addr, old_len, new_len, flags) tcti_libtpms_win_mremap_anon(addr, old_len, new_len)
+#define munmap(addr, len) free(addr)
 #endif
 
