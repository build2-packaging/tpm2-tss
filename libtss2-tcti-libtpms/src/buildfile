intf_libs = # Interface dependencies.
impl_libs = # Implementation dependencies.

using autoconf

h{have-headers}: in{have-headers}
{
  install = false
}

[rule_hint=c.predefs] buildfile{have-headers}: h{have-headers} h{have-headers-dep}
{
  # have-headers.h "-includes" its sibling have-headers-dep.h by quoted
  # name, which needs $src_base on the search path (the generated header
  # itself lives in $out_base). h{have-headers-dep} above is only reached
  # through the compiler's raw -I search path, not through automatic
  # header-dependency extraction (c.predefs doesn't do that), so without
  # listing it explicitly here dist never sees it as reachable and drops
  # it from the source distribution even though it matches the {h c}{**}
  # wildcard below.
  #
  # The buildfile-side variable names (after "@") are deliberately not
  # HAVE_NETINET_IN_H et al: c.predefs.macros looks up an existing
  # buildfile variable of the SAME name as a check name before consulting
  # the builtin catalog (this lets a project override a builtin check),
  # so a plain "safe default" assignment of the same name below would
  # permanently shadow the real platform check on every platform, not
  # just provide a fallback for non-perform operations. Confirmed by
  # forcing HAVE_NETINET_IN_H=true locally on MinGW (which genuinely
  # lacks the header) and seeing the generated fragment echo back "1"
  # instead of running the real check.
  #
  c.predefs.poptions = true
  c.poptions += "-I$src_base"
  c.predefs.macros = HAVE_NETINET_IN_H@have_netinet_in_h \
                     HAVE_UNISTD_H@have_unistd_h \
                     HAVE_SYS_MMAN_H@have_sys_mman_h
}

./: buildfile{have-headers}

# Once any target is explicitly declared a prerequisite of ./ (above),
# build2 stops implicitly registering this directory's other targets as
# defaults, which silently drops everything the {h c}{**} wildcard below
# would otherwise sweep in (private sources, the .map file, etc.) from
# operations like dist. Restore it explicitly.
#
./: lib{tss2-tcti-libtpms}

# Safe defaults for non-perform operations (configure, info, etc.).
#
have_netinet_in_h = [bool] false
have_unistd_h     = [bool] false
have_sys_mman_h   = [bool] false

if ($build.meta_operation == 'perform')
{
  update buildfile{have-headers}
  source $path(buildfile{have-headers})

  have_netinet_in_h = ($have_netinet_in_h == 1 ? true : false)
  have_unistd_h     = ($have_unistd_h     == 1 ? true : false)
  have_sys_mman_h   = ($have_sys_mman_h   == 1 ? true : false)
}

import intf_libs += libtss2-headers%lib{tss2-headers}
import impl_libs += libtss2-mu%lib{tss2-mu}
import impl_libs += libtpms%lib{tpms}

# Public headers.
#
pub = [dir_path] ../include/tss2/

include $pub

pub_hdrs = $($pub/ pub_hdrs)

lib{tss2-tcti-libtpms}: libul{tss2-tcti-libtpms}: $pub/{$pub_hdrs}

# Private headers and sources as well as dependencies.
#
libul{tss2-tcti-libtpms}: {h c}{**} $impl_libs $intf_libs

libs{tss2-tcti-libtpms}: def{tss2-tcti-libtpms}: include = ($c.target.system == 'win32-msvc')
def{tss2-tcti-libtpms}: libul{tss2-tcti-libtpms}

# Build options.
#
# The sources include the public headers with unqualified names, so the
# tss2/ directory is also on the private header search path.
#
out_pfx_inc = [dir_path] $out_root/include/
src_pfx_inc = [dir_path] $src_root/include/
out_pfx_unq = [dir_path] $out_root/include/tss2/
src_pfx_unq = [dir_path] $src_root/include/tss2/
out_pfx_src = [dir_path] $out_root/src/
src_pfx_src = [dir_path] $src_root/src/

c.poptions =+ "-I$out_pfx_src" "-I$src_pfx_src" \
              "-I$out_pfx_inc" "-I$src_pfx_inc" \
              "-I$out_pfx_unq" "-I$src_pfx_unq"

# Matches upstream's own default (autotools --enable-log-file): lets
# TSS2_LOGFILE redirect log output to a file at runtime. Does not
# enable logging itself (see log.c's LOGDEFAULT, warning level).
#
c.poptions += -DLOG_FILE_ENABLED

# tcti-libtpms.c uses dlopen()/dlsym() to load the libtpms shared library
# on every platform except Windows (see tcti-libtpms.c.patch: libtpms is
# already linked directly there, so it just calls the real functions).
#
if ($c.target.class == 'linux')
  c.libs += -ldl

# netinet/in.h (htonl()/ntohl()), unistd.h (close()/lseek(), plus the
# off_t used with truncate()), and sys/mman.h (only for size_t) don't exist
# on compilers targeting the Microsoft UCRT (see the
# have_netinet_in_h/have_unistd_h/have_sys_mman_h autoconf probe above;
# MinGW-w64 genuinely has all three, per this package's own
# build/autoconf/checks/HAVE_UNISTD_H.h override of the builtin catalog's
# otherwise-incorrect MinGW answer for that one header). Fall back to our
# own stand-ins (compat/), one directory per header so that only the
# headers actually missing get added to the search path; the netinet/in.h
# stand-in also defines WIN32_LEAN_AND_MEAN before winsock2.h, which keeps
# tss2_tcti.h's own unguarded <windows.h> from pulling in the legacy
# <winsock.h> later and conflicting with it.
#
if (!$have_netinet_in_h)
  c.poptions += "-I$src_base/compat/netinet_in"

if (!$have_unistd_h)
  c.poptions += "-I$src_base/compat/unistd"

if (!$have_sys_mman_h)
  c.poptions += "-I$src_base/compat/sys_mman"

if ($c.target.class == 'windows')
{
  if ($c.target.system == 'mingw32')
    c.libs += -lws2_32
  else
    c.libs += Ws2_32.lib
}

# mremap()/MREMAP_MAYMOVE are glibc GNU extensions gated behind
# _GNU_SOURCE, which GCC's default -std=gnu17 dialect does not imply.
#
if ($c.target.class == 'linux')
  tss2-tcti/obj{tcti-libtpms}: c.poptions += -D_GNU_SOURCE

# The upstream logging macros are invoked without variadic arguments, which
# Clang only diagnoses in pedantic mode.
#
if ($c.id.type == 'clang')
  c.coptions += -Wno-variadic-macro-arguments-omitted \
                -Wno-unknown-warning-option

# On FreeBSD/macOS/Windows the state-file conf branch in
# Tss2_Tcti_Libtpms_Init() returns early (no mmap()/mremap()/
# posix_fallocate() there), which can leave a cleanup label unused. GNU-style
# compilers only (MSVC's equivalent, C4102, isn't enabled by default).
#
if (($c.target.class == 'bsd' || $c.target.class == 'macos' || $c.target.class == 'windows') \
    && $c.id.type != 'msvc')
  tss2-tcti/obj{tcti-libtpms}: c.coptions += -Wno-unused-label

# dlsym()'s pointer cast triggers -Wpedantic on GCC and Clang, neither of
# which has a dedicated flag for it. GNU-style compilers only.
#
if ($c.class == 'gcc')
  tss2-tcti/obj{tcti-libtpms}: c.coptions += -Wno-pedantic

# The Microsoft UCRT (targeted by both MSVC and Clang in MSVC mode) has no
# POSIX strtok_r(); its strtok_s() is a drop-in replacement (identical
# signature and semantics). MinGW's own CRT already provides strtok_r().
#
if ($c.target.system == 'win32-msvc')
  util/obj{key-value-parse}: c.poptions += -Dstrtok_r=strtok_s

if ($c.target.system == 'mingw32')
  c.loptions += -Wl,--export-all-symbols

# Export options.
#
# The public headers include each other with unqualified names, so consumers
# also need the tss2/ directory on their header search path.
#
lib{tss2-tcti-libtpms}:
{
  c.export.poptions = "-I$out_pfx_inc" "-I$src_pfx_inc" \
                      "-I$out_pfx_unq" "-I$src_pfx_unq"
  c.export.libs = $intf_libs
}

lib{tss2-tcti-libtpms}: c.pkgconfig.include = include/ include/tss2/

# Only export the public API from the shared library on ELF targets.
#
lib{tss2-tcti-libtpms}: file{tss2-tcti-libtpms.map}: include = adhoc

if ($c.target.class == 'linux' || $c.target.class == 'bsd')
  libs{tss2-tcti-libtpms}: c.loptions += "-Wl,--version-script=$src_base/tss2-tcti-libtpms.map"

# For pre-releases use the complete version to make sure they cannot
# be used in place of another pre-release or the final version. See
# the version module for details on the version.* variable values.
#
# A final release uses the same shared library names as upstream (libtool
# version-info 0:0:0): libtss2-tcti-libtpms.so.0.0.0 with SONAME
# libtss2-tcti-libtpms.so.0 on Linux, libtss2-tcti-libtpms.so.0 on BSD, and
# libtss2-tcti-libtpms.0.dylib on macOS. linux@ needs MAJOR.MINOR[.EXTRA],
# macos@ and bsd@ are not implemented, so the BSD name is set through the
# extension.
#
if $version.pre_release
  lib{tss2-tcti-libtpms}: bin.lib.version = "-$version.project_id"
elif ($c.target.class == 'macos')
  lib{tss2-tcti-libtpms}: bin.lib.version = ".0"
elif ($c.target.class == 'bsd')
  libs{tss2-tcti-libtpms}: extension = "so.0"
else
  lib{tss2-tcti-libtpms}: bin.lib.version = "-0" linux@"0.0.0"

# Don't install private headers.
#
h{*}: install = false
