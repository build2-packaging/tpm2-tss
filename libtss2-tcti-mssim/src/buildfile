intf_libs = # Interface dependencies.
impl_libs = # Implementation dependencies.

import intf_libs += libtss2-headers%lib{tss2-headers}
import impl_libs += libtss2-mu%lib{tss2-mu}

# Public headers.
#
pub = [dir_path] ../include/tss2/

include $pub

pub_hdrs = $($pub/ pub_hdrs)

lib{tss2-tcti-mssim}: libul{tss2-tcti-mssim}: $pub/{$pub_hdrs}

# Private headers and sources as well as dependencies.
#
libul{tss2-tcti-mssim}: {h c}{**} $impl_libs $intf_libs

libs{tss2-tcti-mssim}: def{tss2-tcti-mssim}: include = ($c.target.system == 'win32-msvc')
def{tss2-tcti-mssim}: libul{tss2-tcti-mssim}

# Build options.
#
# The sources include the public headers with unqualified names, so the
# tss2/ directory is also on the private header search path.
#
out_pfx_inc = [dir_path] $out_root/include/
src_pfx_inc = [dir_path] $src_root/include/
out_pfx_unq = [dir_path] $out_root/include/tss2/
src_pfx_unq = [dir_path] $src_root/include/tss2/
out_pfx_src = [dir_path] $out_root/src/
src_pfx_src = [dir_path] $src_root/src/

c.poptions =+ "-I$out_pfx_src" "-I$src_pfx_src" \
              "-I$out_pfx_inc" "-I$src_pfx_inc" \
              "-I$out_pfx_unq" "-I$src_pfx_unq"

# Matches upstream's own default (autotools --enable-log-file): lets
# TSS2_LOGFILE redirect log output to a file at runtime. Does not
# enable logging itself (see log.c's LOGDEFAULT, warning level).
#
c.poptions += -DLOG_FILE_ENABLED

# tss2_tcti.h's TSS2_TCTI_POLL_HANDLE typedef #includes <windows.h>
# unguarded, which without WIN32_LEAN_AND_MEAN pulls in the legacy
# <winsock.h>. util-io/io.h's <winsock2.h>/<ws2tcpip.h> then conflicts
# with it (duplicate struct/macro definitions).
#
if ($c.target.class == 'windows')
{
  c.poptions += -DWIN32_LEAN_AND_MEAN

  if ($c.target.system == 'mingw32')
    c.libs += -lws2_32
  else
    c.libs += Ws2_32.lib
}

# The upstream logging macros are invoked without variadic arguments, which
# Clang only diagnoses in pedantic mode.
#
if ($c.id.type == 'clang')
  c.coptions += -Wno-variadic-macro-arguments-omitted \
                -Wno-unknown-warning-option

# The Microsoft UCRT (targeted by both MSVC and Clang in MSVC mode) has no
# POSIX strtok_r(); its strtok_s() is a drop-in replacement (identical
# signature and semantics). MinGW's own CRT already provides strtok_r().
#
if ($c.target.system == 'win32-msvc')
  util/obj{key-value-parse}: c.poptions += -Dstrtok_r=strtok_s

# util-io/io.c assigns sizes already bounded well under 64K into a
# narrower int, which MSVC's cl.exe flags at its default warning level;
# GCC/Clang do not warn on this by default. tcti-mssim.c's sscanf()/
# strdup() calls are the standard MSVC opinion that these POSIX/C-standard
# names are "unsafe" in favor of its own _s-suffixed variants; both calls
# here are already bounded (a fixed-format sscanf(), a strdup() of a
# NUL-terminated string), so there is nothing to actually fix. Unlike the
# narrowing warning above, the deprecation one comes from the UCRT
# headers' own __declspec(deprecated(...)) annotation, not a compiler-
# specific check, so Clang targeting win32-msvc sees it too: just
# under its own generic -Wdeprecated-declarations name, not a /wd number.
#
if ($c.id.type == 'msvc')
  util-io/obj{io}: c.coptions += /wd4267

if ($c.target.system == 'win32-msvc')
{
  if ($c.id.type == 'msvc')
    tss2-tcti/obj{tcti-mssim}: c.coptions += /wd4996
  elif ($c.id.type == 'clang')
    tss2-tcti/obj{tcti-mssim}: c.coptions += -Wno-deprecated-declarations
}

if ($c.target.system == 'mingw32')
  c.loptions += -Wl,--export-all-symbols

# Export options.
#
# The public headers include each other with unqualified names, so consumers
# also need the tss2/ directory on their header search path.
#
lib{tss2-tcti-mssim}:
{
  c.export.poptions = "-I$out_pfx_inc" "-I$src_pfx_inc" \
                      "-I$out_pfx_unq" "-I$src_pfx_unq"
  c.export.libs = $intf_libs
}

lib{tss2-tcti-mssim}: c.pkgconfig.include = include/ include/tss2/

# Only export the public API from the shared library on ELF targets.
#
lib{tss2-tcti-mssim}: file{tss2-tcti-mssim.map}: include = adhoc

if ($c.target.class == 'linux' || $c.target.class == 'bsd')
  libs{tss2-tcti-mssim}: c.loptions += "-Wl,--version-script=$src_base/tss2-tcti-mssim.map"

# For pre-releases use the complete version to make sure they cannot
# be used in place of another pre-release or the final version. See
# the version module for details on the version.* variable values.
#
# A final release uses the same shared library names as upstream (libtool
# version-info 0:0:0): libtss2-tcti-mssim.so.0.0.0 with SONAME libtss2-tcti-mssim.so.0 on
# Linux, libtss2-tcti-mssim.so.0 on BSD, and libtss2-tcti-mssim.0.dylib on macOS. linux@
# needs MAJOR.MINOR[.EXTRA], macos@ and bsd@ are not implemented, so the
# BSD name is set through the extension.
#
if $version.pre_release
  lib{tss2-tcti-mssim}: bin.lib.version = "-$version.project_id"
elif ($c.target.class == 'macos')
  lib{tss2-tcti-mssim}: bin.lib.version = ".0"
elif ($c.target.class == 'bsd')
  libs{tss2-tcti-mssim}: extension = "so.0"
else
  lib{tss2-tcti-mssim}: bin.lib.version = "-0" linux@"0.0.0"

# Don't install private headers.
#
h{*}: install = false
